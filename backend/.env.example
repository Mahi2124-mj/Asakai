# asakai server configuration — copy to .env and edit.

# PostgreSQL (leave empty to run without a database: demo data + admin login from below)
DATABASE_URL=postgresql://asakai:asakai@localhost:5432/asakai

# Plant maintenance database, read-only. Machine master (maintenance_machines) feeds the
# Zone / Line / Machine No. slicers on Maintenance, Die Maintenance and Toolroom. The user
# only needs SELECT on maintenance_machines. Empty = the app uses its built-in demo machine list.
MAINT_DATABASE_URL=postgresql://asakai_ro:CHANGE_ME@localhost:5432/maintenance_db
MASTER_CACHE_SECONDS=600

# Redis cache (optional, fail-safe: server keeps working if Redis is down; an in-process cache is used instead)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=24

# Bootstrap admin (created in the users table on first start if it is empty;
# also used for login when no database is configured)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Comma separated origins allowed to call the API from a browser. Capacitor apps use
# http://localhost (Android) and capacitor://localhost (iOS).
CORS_ORIGINS=http://localhost,capacitor://localhost,http://localhost:5173,https://localhost

# demo | live   (live = never fall back to demo data)
DATA_MODE=demo
